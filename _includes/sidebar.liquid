<div class="sidebar-content">
  {% if site.sidebar_img %}
  <div class="sidebar-avatar text-center">
    <img src="{{ site.sidebar_img | prepend: '/assets/img/' | relative_url }}" 
         class="img-fluid rounded-circle z-depth-1" 
         alt="Portrait of {{ site.first_name }} {{ site.last_name }}">
  </div>
  {% endif %}

  <div class="sidebar-identity text-center">
    {% unless page.page_id == 'about' %}
      <h2>{{ site.first_name }} {{ site.last_name }}</h2>
      <p class="sidebar-role">{{ site.position }}</p>
    {% endunless %}
    <p class="sidebar-affiliation">{{ site.affiliation_short }} · {{ site.location }}</p>
  </div>

  <div class="sidebar-contact">
    {% if site.email %}
    <div class="sidebar-item">
      <i class="fas fa-envelope" aria-hidden="true"></i><a href="mailto:{{ site.email }}">{{ site.email }}</a>
    </div>
    {% endif %}
  </div>

  <div class="sidebar-actions" aria-label="Academic profiles and CV">
    {% if site.scholar_userid %}
      <a href="https://scholar.google.com/citations?user={{ site.scholar_userid }}" target="_blank" title="Google Scholar" aria-label="Google Scholar"><i class="ai ai-google-scholar" aria-hidden="true"></i></a>
    {% endif %}

    {% if site.orcid_id %}
      <a href="https://orcid.org/{{ site.orcid_id }}" target="_blank" title="ORCID" aria-label="ORCID"><i class="ai ai-orcid" aria-hidden="true"></i></a>
    {% endif %}

    {% if site.github_username %}
      <a href="https://github.com/{{ site.github_username }}" target="_blank" title="GitHub" aria-label="GitHub"><i class="fab fa-github" aria-hidden="true"></i></a>
    {% endif %}

    {% if site.researchgate_username %}
      <a href="https://www.researchgate.net/profile/{{ site.researchgate_username }}" target="_blank" title="ResearchGate" aria-label="ResearchGate"><i class="ai ai-researchgate" aria-hidden="true"></i></a>
    {% endif %}

    {% if site.cv_url %}
      <a href="{{ site.cv_url | prepend: '/assets/pdf/' | relative_url }}" target="_blank" title="Download CV" aria-label="Download CV"><i class="fas fa-file-pdf" aria-hidden="true"></i></a>
    {% endif %}
  </div>
</div>
