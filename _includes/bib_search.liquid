{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <label class="sr-only" for="bibsearch">{{ include.placeholder | default: 'Filter publications' }}</label>
  <div class="bibsearch-field">
    <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
    <input
      type="search"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="{{ include.placeholder | default: 'Filter publications' }}"
    >
  </div>
{% endif %}
